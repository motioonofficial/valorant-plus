# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose up -d gives you this one)
DATABASE_URL="postgresql://drill:drill@localhost:5432/drill"

PORT=4000
# 127.0.0.1 = only this machine. Use 0.0.0.0 on a real server behind a reverse proxy.
HOST="127.0.0.1"
# Public URL of this server, used to build the RSO redirect URI
PUBLIC_URL="http://localhost:4000"

# Riot Developer Portal → your registered product
RIOT_API_KEY=""
RSO_CLIENT_ID=""
RSO_CLIENT_SECRET=""

# Where the desktop app receives the session after login (custom protocol)
DESKTOP_CALLBACK_URL="drill://auth"

# Development only: skip RSO and log in as a fake user via /auth/dev-login.
# Never enable this on a public server.
DEV_LOGIN=false
